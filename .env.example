# Domain
DOMAIN=wpm.cash

# Timezone
TZ=America/New_York

# Postgres (wpm-db)
POSTGRES_USER=wpm
POSTGRES_PASSWORD=wpm
POSTGRES_DB=wpm

# Better-auth (wpm-web)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4102
# In-container URL is set by docker-compose. For host-side tools (drizzle-kit, tsx) use localhost:
DATABASE_URL=postgres://wpm:wpm@localhost:5432/wpm
ADMIN_EMAILS=

# Oracle → Web service auth
WPM_ORACLE_SERVICE_TOKEN=
