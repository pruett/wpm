# Better-auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4102

# Postgres — Neon pooled URL in production, local docker-compose URL in dev
DATABASE_URL=postgres://wpm:wpm@localhost:5432/wpm

# Comma-separated list of admin email addresses
ADMIN_EMAILS=

# Cron bearer token — Vercel convention (Authorization: Bearer ${CRON_SECRET})
CRON_SECRET=

# Kalshi API auth (required). Generate keypair: see keys/kalshi/.
# Upload public.pem to Kalshi → paste the returned UUID into KALSHI_KEY_ID.
# Dev: point KALSHI_PRIVATE_KEY_PATH at the file.
# Vercel: paste full PEM contents into KALSHI_PRIVATE_KEY (KALSHI_PRIVATE_KEY
# takes precedence over the path if both are set).
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./keys/kalshi/private.pem
# KALSHI_PRIVATE_KEY=

# When set, sendMagicLink appends each {email,url} as a JSON line here.
# Required for `bun run test:e2e` to reuse a running dev server on :3000.
WPM_MAGIC_LINK_CAPTURE_PATH=./wpm-e2e-magic-links.log
