# Better-auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4102

# Postgres — Neon pooled URL in production, local docker-compose URL in dev
DATABASE_URL=postgres://wpm:wpm@localhost:5432/wpm

# Comma-separated list of admin email addresses
ADMIN_EMAILS=

# Cron bearer token — Vercel convention (Authorization: Bearer ${CRON_SECRET})
CRON_SECRET=
