# Paste your bot token from @BotFather here
TELEGRAM_BOT_TOKEN=

# Only needed in webhook mode (production deploys). Any random string;
# Telegram sends it with every webhook request and the adapter rejects
# requests that don't carry it.
# TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Optional: your bot's @username (without the @). Auto-detected via getMe if omitted.
# TELEGRAM_BOT_USERNAME=

# Sent by Vercel with every cron request (/api/sync, /api/summary); the handlers
# reject requests that don't carry it. Any random string.
# CRON_SECRET=

# Anthropic API key for the LLM calls (settlement roasts + weekly recap). The
# @ai-sdk/anthropic provider reads this directly — required in both local and
# production. Get one at console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=

# Optional: override the models the LLM calls use (bare Anthropic model id, no
# provider prefix). Both default to claude-haiku-4-5.
# SETTLEMENT_MODEL=
# SUMMARY_MODEL=
