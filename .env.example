# Better-auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4102

# Postgres — Neon pooled URL in production, local docker-compose URL in dev
DATABASE_URL=postgres://wpm:wpm@localhost:5432/wpm

# Comma-separated list of admin email addresses
ADMIN_EMAILS=

# Cron bearer token — Vercel convention (Authorization: Bearer ${CRON_SECRET})
CRON_SECRET=

# When set, sendMagicLink appends each {email,url} as a JSON line here.
# Required for `bun run test:e2e` to reuse a running dev server on :3000.
WPM_MAGIC_LINK_CAPTURE_PATH=./wpm-e2e-magic-links.log
