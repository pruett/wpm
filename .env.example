# Domain
DOMAIN=wpm.cash

# Timezone
TZ=America/New_York

# Secrets
BETTER_AUTH_SECRET=
RESEND_API_KEY=

# Email (optional)
EMAIL_FROM=WPM <noreply@wpm.cash>

# Better-auth (wpm-web)
BETTER_AUTH_URL=http://localhost:4102
DATABASE_URL=./wpm.db
ADMIN_EMAILS=

# Service-to-service auth (wpm-api trusts these bearer tokens)
WPM_WEB_SERVICE_TOKEN=
WPM_ORACLE_SERVICE_TOKEN=
