# Domain
DOMAIN=wpm.cash

# Timezone
TZ=America/New_York

# Better-auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4102
DATABASE_URL=./wpm.db
ADMIN_EMAILS=

# Oracle → Web service auth (must match packages/oracle/.env)
WPM_ORACLE_SERVICE_TOKEN=
