{
  "name": "wpm",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "drizzle-kit migrate && next build",
    "start": "bun run db:migrate && next start",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:contract": "vitest run --config vitest.contract.config.ts --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --write",
    "fmt:all": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "clean": "rm -rf node_modules bun.lock .next",
    "db:generate": "drizzle-kit generate && bun run src/lib/db/seeds/append-to-migrations.ts",
    "db:better-auth:generate": "bun x auth@latest generate --output ./src/lib/db/schema/auth.ts --yes",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push && bun run db:seed",
    "db:seed": "bun run src/lib/db/seeds/treasury.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@better-auth/drizzle-adapter": "^1.6.9",
    "@better-auth/passkey": "^1.6.9",
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/postcss": "^4.2.4",
    "better-auth": "^1.6.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "kalshi-typescript": "^3.15.0",
    "lucide-react": "^1.14.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "^19.2.6",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.75.0",
    "react-resizable-panels": "^4.11.0",
    "recharts": "3.8.0",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.63.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "bun@1.3.11"
}
