{
  "name": "wpm-2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/bot/server.ts",
    "start": "bun src/bot/server.ts",
    "cli": "bun src/utils/cli.ts",
    "webhook": "bun src/utils/webhook.ts",
    "build:api": "rm -f api/*.mjs && bun build src/api/sync.ts src/api/telegram.ts src/api/health.ts --outdir api --target node --format esm --external pg-native --entry-naming '[name].mjs'",
    "deploy": "vercel deploy --prod",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chat-adapter/state-pg": "^4.30.0",
    "@chat-adapter/telegram": "latest",
    "chat": "latest",
    "drizzle-orm": "^0.45.2",
    "kalshi-typescript": "^3.20.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5"
  }
}
